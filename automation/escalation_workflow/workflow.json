{
  "name": "Copilot Low-Confidence Escalation Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "escalation-webhook",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "options": {},
        "text": "Escalation Alert for Session {{\[\"session_id\"]}}: {{\[\"query\"]}}"
      },
      "name": "Notify Supervisor (Email/Slack)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [300, 200],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "notice": "Jira integration currently disabled pending enterprise decision"
      },
      "name": "Jira Issue Creator (DISABLED/TODO)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [300, 400],
      "disabled": true
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "={{\.FASTAPI_BASE_URL}}/api/v1/analytics/escalations/log",
        "options": {}
      },
      "name": "Log Escalation Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "requestMethod": "GET",
        "url": "={{\.FASTAPI_BASE_URL}}/api/v1/analytics/escalations/{{\[\"escalation_id\"]}}/status",
        "options": {}
      },
      "name": "Poll Resolution Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          { "node": "Notify Supervisor (Email/Slack)", "type": "main", "index": 0 },
          { "node": "Jira Issue Creator (DISABLED/TODO)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Notify Supervisor (Email/Slack)": { "main": [[{ "node": "Log Escalation Event", "type": "main", "index": 0 }]] },
    "Log Escalation Event": { "main": [[{ "node": "Poll Resolution Status", "type": "main", "index": 0 }]] }
  }
}
