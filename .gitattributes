# Normalize line endings automatically
* text=auto

# Shell scripts (macOS/Linux)
*.sh text eol=lf

# Batch scripts (Windows)
*.bat text eol=crlf

# Python
*.py text eol=lf

# JavaScript / TypeScript
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# JSON / YAML / Markdown
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf