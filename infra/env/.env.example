# WorkMate AI Infrastructure Environment Variables Example

# Snowflake Managed Cloud Persistence & Cortex AI Services
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=WORKMATE_APP_USER
SNOWFLAKE_PASSWORD=YourSecurePasswordHere
SNOWFLAKE_WAREHOUSE=WORKMATE_WH
SNOWFLAKE_DATABASE=WORKMATE_DB
SNOWFLAKE_SCHEMA=PUBLIC

# Security & RBAC Auth Configuration
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# n8n Automation Engine Webhooks
N8N_WEBHOOK_BASE_URL=https://n8n.your-domain.com/webhook
